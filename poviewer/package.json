{
  "name": "poviewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "description": "Three-pane POV viewer for BKC AI Triad research documents",
  "main": "dist/main/poviewer/src/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5174 && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "test": "vitest run",
    "licenses": "node scripts/generate-notices.cjs --output THIRD-PARTY-NOTICES.txt",
    "build": "tsc -p tsconfig.main.json && vite build && npm run licenses",
    "lint": "eslint src/ && node ../lib/eslint-rules/check-complexity-budget-disables.mjs src"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
