# Search-tool ignore list (ripgrep / Claude Code Glob+Grep). Not a git ignore.
# Worktrees are full repo copies: searching them times out and returns duplicate
# hits that waste agent context. ripgrep reads this file even when VCS ignores
# are bypassed. To search a worktree on purpose, run the search inside it.
.worktrees/
.claude/worktrees/
**/.worktrees/
node_modules/

# Build output (generated; kept out of search so large/duplicate hits don't
# time out and push agents into broad reads — Orca Support, p/888). A pattern
# with no leading slash matches at any depth, so dist/ covers the per-app dirs
# (taxonomy-editor/, poviewer/, summary-viewer/).
dist/
coverage/
.vite/
*.tsbuildinfo
