#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit — block direct commits on the shared-tree `main` checkout (t/1926).
#
# WHY: the fleet shares one `main` checkout. A commit made directly on its `main`
# branch stays local-only, diverges `main` from `origin`, and gets swept into the
# next agent's commit or wiped by the next reconcile. That treadmill (and one
# near-loss of genuine work, 7e1f94a2) is what this hook stops. The friendly Orca
# `direct-main-commit-warning` nudge only advised; this refuses.
#
# CARVE-OUTS (co-located here per the Gate Co-Location rule, t/1589 — NOT in a
# ticket or external doc):
#   • Linked worktrees are ALLOWED on a NAMED branch (git-dir != git-common-dir).
#     /land-from-worktree is branch-first (`git worktree add -b`), so landing
#     commits sit on a named PR branch and are never blocked.
#   • A commit on a DETACHED HEAD inside a worktree is REFUSED (t/2009): it would be
#     an orphaned commit, lost on the next re-detach. Fix = create the branch first.
#   • Any branch other than `main` (on the shared checkout) is ALLOWED.
#   • Owner / emergency override: `git commit --no-verify` (git skips all hooks).
#   • Fail-OPEN: if any git introspection errors, the hook ALLOWS the commit — a
#     broken guard must never block legitimate work.
#
# ACTIVATION (one-time, per checkout — git does not auto-run committed hooks):
#   git config core.hooksPath .githooks
# Documented in root AGENTS.md so a fresh clone re-enables enforcement.
# ─────────────────────────────────────────────────────────────────────────────

# ── AGENTS.md tracking audit (t/2080) ────────────────────────────────────────
# Runs FIRST and on EVERY commit, before the branch logic below returns early —
# this guards WHAT you are committing, not WHERE, so a worktree commit on a named
# branch (which exits 0 below) must still be checked.
#
# Guards two failures the branch rules cannot see: a file tracked in BOTH the code
# repo and the overlay (free to diverge — root AGENTS.md did), and a role
# AGENTS.md tracked by NEITHER (existing in one place on one machine; two were
# found that way, recovered at overlay 01d782f).
#
# Only exit 1 blocks. Exit 2 (internal error) and a missing script both ALLOW the
# commit, matching this hook's fail-OPEN rule: a broken guard must never block
# legitimate work. Skipped entirely when the private overlay is absent, since the
# audit cannot see the overlay's tracking set from a public checkout.
if [ -f "$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/agent-file-owner.sh" ]; then
  QUIET=1 sh "$(git rev-parse --show-toplevel)/.githooks/agent-file-owner.sh" --audit
  if [ $? -eq 1 ]; then
    cat >&2 <<'MSG'

  ✖ BLOCKED: AGENTS.md tracking is ambiguous (t/2080). Details above.

  Query one file's home:
    sh .githooks/agent-file-owner.sh --path <file>

  Owner / emergency override (bypasses this hook):
    git commit --no-verify
MSG
    exit 1
  fi
fi

# ── Junk-file detection (t/2112) ─────────────────────────────────────────────
# Shell-quoting accidents write command fragments as untracked filenames (e.g.
# "120s", "24", "{,", "m.id"). These pollute `git status`, can trip glob-based
# tooling, and make real WIP hard to spot. This check warns (non-blocking) so
# agents clean up without needing to hand-inspect every dirty-file entry.
#
# Patterns flagged (heuristics; false positives acceptable — non-blocking):
#   1. Single-char basename before first dot  → e.g. m.id, e.level
#   2. Name begins with a digit              → e.g. 120s, 24, 0, 30s
#   3. Name contains shell metacharacters    → e.g. {,  `,  c.name)  string[]
#
# Exemptions (co-located here, not in ticket history):
#   - Paths under node_modules/ (legitimate extensionless binaries: LICENSE, tsc)
#   - Paths under .agents/ (overlay-managed directories)
#   - Trailing-slash entries (directories, not files)
#   - Any file with more than one dot-separated segment AND basename > 1 char
#     is skipped as likely legitimate (e.g. package-lock.json, .gitignore).
#
# Runs on EVERY commit (not just main) so worktree commits also benefit.
# Fail-OPEN: any error in the detection skips the warning.
_toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || _toplevel="."

# Shared matcher (t/4149 item 3): same three heuristics used by both the
# untracked warn-only scan below AND the staged-0-byte blocking scan after it.
# Reads one filename from argv, prints it back and returns 0 on a match.
_is_junk_name() {
  _n=$(basename "$1")
  _b="${_n%%.*}"
  if [ "${#_b}" -eq 1 ] && [ "$_n" != "$_b" ]; then
    printf '%s\n' "$1"; return 0
  fi
  if [ "$_n" = "$_b" ]; then
    case "$_n" in [0-9]*) printf '%s\n' "$1"; return 0 ;; esac
  fi
  case "$_n" in
    *[\`\{\}\(\)\,\[\]]*) printf '%s\n' "$1"; return 0 ;;
  esac
  return 1
}

_junk=$(
  git -C "$_toplevel" status --porcelain 2>/dev/null \
    | grep '^?? ' | sed 's|^?? ||' \
    | grep -v '/node_modules' | grep -v '/\.agents/' | grep -v '/$' \
    | while IFS= read -r _f; do
        _is_junk_name "$_f" || true
      done
) 2>/dev/null
if [ -n "$_junk" ]; then
  printf >&2 '\n  ⚠ WARNING: untracked junk-pattern files detected (t/2112).\n'
  printf >&2 '  These look like shell-quoting accident artifacts — verify and remove:\n'
  printf '%s\n' "$_junk" | while IFS= read -r _f; do
    printf >&2 "    rm -- '%s'\n" "$_f"
  done
  printf >&2 '  See Shell Quoting Rule in root AGENTS.md. (Non-blocking — commit proceeds.)\n\n'
fi

# ── 0-byte junk-file REFUSAL (t/4149 item 3) ─────────────────────────────────
# The scan above only ever looks at UNTRACKED files and only ever warns. If a
# shell-quoting fragment gets `git add`-ed (staged), it's invisible to that scan
# entirely (no longer in the `?? ` listing) and would otherwise commit clean.
# This is the stricter case: a STAGED, newly-added file that is BOTH 0 bytes
# AND matches the same junk-name heuristics is almost certainly an accident,
# never a legitimate 0-byte file someone meant to commit (an empty marker file
# a human deliberately creates is never also shell-metacharacter-shaped or
# digit-leading) — so this one REFUSES rather than warns.
# Fail-OPEN: any error in the detection allows the commit.
_zerobyte_junk=$(
  git -C "$_toplevel" diff --cached --name-only --diff-filter=A 2>/dev/null \
    | while IFS= read -r _f; do
        _size=$(git -C "$_toplevel" cat-file -s ":$_f" 2>/dev/null) || continue
        [ "$_size" = "0" ] || continue
        _is_junk_name "$_f" || true
      done
) 2>/dev/null
if [ -n "$_zerobyte_junk" ]; then
  cat >&2 <<MSG

  ✖ BLOCKED: staged 0-byte file(s) with a shell-quoting-accident-shaped name (t/4149 item 3, t/2112 class).
$(printf '%s\n' "$_zerobyte_junk" | while IFS= read -r _f; do printf '    %s\n' "$_f"; done)

  Confirm each is empty and untracked-by-intent, then unstage and remove:
$(printf '%s\n' "$_zerobyte_junk" | while IFS= read -r _f; do printf "    git restore --staged -- '%s' && rm -- '%s'\n" "$_f" "$_f"; done)

  Owner / emergency override (bypasses this hook):
    git commit --no-verify
MSG
  exit 1
fi

# Normalize BOTH paths through `cd && pwd` so the comparison is format-stable on
# Git-for-Windows (where --absolute-git-dir yields `C:/…` but a relative dir cd's
# to `/c/…`). Mixing the two styles would read the main checkout as a worktree and
# silently fail open.
gd=$(cd "$(git rev-parse --git-dir 2>/dev/null)" 2>/dev/null && pwd) || exit 0
cdir=$(cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd) || exit 0
[ -n "$gd" ] && [ -n "$cdir" ] || exit 0

# Linked worktree: allow ONLY on a named branch. A commit on a DETACHED HEAD here
# is orphaned-commit risk (lost on the next re-detach unless pushed); the
# branch-first flow (`worktree add -b`) makes it a named branch from the start.
if [ "$gd" != "$cdir" ]; then
  git symbolic-ref -q HEAD >/dev/null 2>&1 && exit 0   # named branch → allow (landing)
  cat >&2 <<'MSG'

  ✖ BLOCKED: commit on a DETACHED HEAD inside a worktree (t/2009).
    A detached-HEAD commit is orphaned — lost on the next re-detach unless pushed.

  Create the worktree BRANCH-FIRST so commits land on a named PR branch:
    git worktree add -b <type>/<slug>-t<ticket> .worktrees/<name> origin/main
    #  …commit on the named branch…  →  git push origin <branch>  →  gh pr create

  Already detached with work to save? Name the branch in place, then commit:
    git switch -c <type>/<slug>-t<ticket>

  Owner / emergency override (bypasses this hook):
    git commit --no-verify
MSG
  exit 1
fi

# Shared checkout: only the `main` branch is protected.
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
[ "$branch" = "main" ] || exit 0

# ── Workflow-mode switch (t/3638) ────────────────────────────────────────────
# In `direct` mode, skip ONLY the shared-`main` refusal below. The detached-HEAD-in-
# worktree refusal (t/2009, above) is UNAFFECTED — it guards a different failure and
# fires in BOTH modes. FAIL-SAFE: the reader defaults to `worktree` on any error; here we
# additionally force `worktree` unless the helper printed exactly `direct`, so a missing or
# broken helper TIGHTENS (keeps the refusal), never loosens.
mode=$(sh "$_toplevel/.githooks/read-workflow-mode.sh" 2>/dev/null)
[ "$mode" = "direct" ] || mode=worktree
if [ "$mode" = "direct" ]; then exit 0; fi

# Direct commit on the shared `main` checkout — refuse.
cat >&2 <<'MSG'

  ✖ BLOCKED: direct commit to the shared-tree `main` checkout (t/1926).
    This strands work local-only and diverges `main` from `origin`.

  Land via /land-from-worktree instead (branch-first):
    git worktree add -b <type>/<slug>-t<ticket> .worktrees/<name> origin/main
    #  …commit on the named branch inside the worktree…
    git push origin <branch>   →   gh pr create   →   self-merge on green

  Owner / emergency override (bypasses this hook):
    git commit --no-verify
MSG
exit 1
