#!/bin/sh
# pre-push — run CI's fast TypeScript checks, plus PowerShell-parse and Python-compile checks
# (t/289), on the files this push changes, so real failures are caught in ~1-2 minutes locally
# instead of a 12-minute CI run.
# All logic, the rationale and the fail-open rules live in
# operations/devops/pre-push-checks.sh. This wrapper only maps git's push info to a
# base..head range per pushed ref.
#
# Overrides (visible in the command): AITRIAD_PREPUSH=skip git push   or   git push --no-verify
# Activation: git config core.hooksPath .githooks (root AGENTS.md).

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
CHECKS="$ROOT/operations/devops/pre-push-checks.sh"
QUEUE_GUARD="$ROOT/operations/devops/check-queued-push-guard.sh"
# t/4858 TL review: AITRIAD_PREPUSH=skip must only skip the (slower) TypeScript checks
# below, never the queued-push guard -- a queued PR's head can race a push regardless of
# whether the pusher wants the TS checks run, so the guard is not an optional check.
SKIP_TS="${AITRIAD_PREPUSH:-}"
if [ "$SKIP_TS" = "skip" ]; then
  echo "pre-push: WARN TypeScript, PowerShell-parse and Python-compile checks skipped by AITRIAD_PREPUSH=skip; CI will still run them. The queued-push guard and control-character check still run." >&2
fi
if [ ! -f "$CHECKS" ] && [ "$SKIP_TS" != "skip" ]; then
  echo "pre-push: WARN $CHECKS not found (branch predates it?); skipping the TypeScript, PowerShell and Python checks." >&2
fi
CTRL_LINT="$ROOT/.github/scripts/check-control-chars.mjs"
ZERO=0000000000000000000000000000000000000000
# The checks read the working tree, so they only describe a pushed commit that is the
# checked-out one. Pushing any other ref (git push origin some-other-branch) would check
# the wrong code, so that ref is skipped with a WARN instead of blocked or passed on bad evidence.
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null)

status=0
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # deleting a remote ref
  case "$remote_ref" in refs/tags/*) continue ;; esac
  if [ "$local_sha" != "$HEAD_SHA" ]; then
    echo "pre-push: WARN $local_ref is not the checked-out commit; skipping checks for it (they read the working tree)." >&2
    continue
  fi
  # t/4858: refuse pushing to a branch whose PR is queued or auto-merge-armed, before the
  # (slower) TS checks run -- a queued PR can merge the OLD head while this push races it.
  if [ -f "$QUEUE_GUARD" ]; then
    branch=${remote_ref#refs/heads/}
    sh "$QUEUE_GUARD" "$branch" || { status=1; continue; }
  fi
  base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
  if [ -z "$base" ] && [ "$remote_sha" != "$ZERO" ]; then base=$remote_sha; fi
  if [ -z "$base" ]; then
    echo "pre-push: WARN no origin/main to diff $local_ref against; skipping checks." >&2
    continue
  fi
  # t/128: raw control bytes in the files this push changes (invisible in PR diffs). Fast, so it runs
  # even under AITRIAD_PREPUSH=skip; AITRIAD_CONTROLCHARS=skip is its own visible override.
  if [ "${AITRIAD_CONTROLCHARS:-}" = "skip" ]; then
    echo "pre-push: WARN control-character check skipped by AITRIAD_CONTROLCHARS=skip; CI still runs it." >&2
  elif [ ! -f "$CTRL_LINT" ] || ! command -v node >/dev/null 2>&1; then
    echo "pre-push: WARN control-character check unavailable (no node or no $CTRL_LINT); CI still runs it." >&2
  else
    # t/130: NUL-separated (git diff -z into --stdin0), so a changed path with spaces is scanned whole.
    ( cd "$ROOT" && git diff -z --name-only --diff-filter=ACMR "$base" "$local_sha" 2>/dev/null \
        | node "$CTRL_LINT" --stdin0 >/tmp/ctrl-lint.$$ 2>&1 ) || {
      grep -v '^::' /tmp/ctrl-lint.$$ >&2
      echo "pre-push: BLOCKED raw control byte(s) in changed files (t/128). Replace them with an escape, or allowlist the file with a reason in .github/ci/control-chars-allowlist.json." >&2
      status=1
    }
    rm -f /tmp/ctrl-lint.$$
  fi
  if [ "$SKIP_TS" = "skip" ] || [ ! -f "$CHECKS" ]; then
    continue
  fi
  sh "$CHECKS" "$base" "$local_sha" || status=1
done
exit $status
