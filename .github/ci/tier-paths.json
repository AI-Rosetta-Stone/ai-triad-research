{
  "_comment": "t/4103 — tier-declaration check path floor (R1) and lint-severity globs (R2c). See operations/devops/tier-check-predicate.mjs for the rules this config feeds. t/566 (TL p/9#613, p/9#617): the R1 floor covers the server auth/AI gates (server/security, server/ai, routes/admin*, routes/diagnostics, anonAiRoutes, authGates) and deploy/azure code and config only. deploy/azure runbook .md files are deliberately NOT floored: they do not execute, and continuous-deploy holds any batch touching R1, so floored docs would hold deploys on doc edits.",
  "r1Paths": [
    ".github/ci/required-contexts.json",
    ".github/ci/tier-paths.json",
    ".github/CODEOWNERS",
    ".github/workflows/consult-hold-guard.yml",
    ".github/workflows/joint-gv-guard.yml",
    ".github/workflows/required-contexts-drift.yml",
    ".github/workflows/tier-check.yml",
    "operations/devops/tier-check-predicate.mjs",
    "deploy/azure/main.bicep",
    "deploy/azure/deploy.ps1",
    ".github/workflows/deploy-azure.yml",
    "taxonomy-editor/src/server/anonAiRoutes.ts",
    "taxonomy-editor/src/server/authGates.ts",
    "taxonomy-editor/src/server/routes/diagnostics.ts"
  ],
  "r1Globs": [
    "operations/devops/AgentAppToken.psm1",
    "operations/devops/Move-PiCredential*.ps1",
    "taxonomy-editor/src/server/security/*",
    "taxonomy-editor/src/server/ai/*",
    "taxonomy-editor/src/server/routes/admin*.ts",
    "deploy/azure/*.bicep",
    "deploy/azure/*.ps1",
    "deploy/azure/*.sh",
    "deploy/azure/Dockerfile*",
    "deploy/azure/runner/*",
    "deploy/azure/.env.template",
    "deploy/azure/docker-compose*.yml"
  ],
  "r2cGlobs": [
    "**/eslint.config.js",
    "**/eslint.config.mjs",
    "**/eslint.config.cjs",
    "**/eslint.config.ts",
    "**/.eslintrc*",
    "**/PSScriptAnalyzerSettings.psd1"
  ],
  "schemaDirPrefixes": [
    "lib/schema/",
    "taxonomy/schemas/",
    "lib/brief/schemas/"
  ],
  "graceCutoffISO": "2026-10-08T00:00:00Z"
}
