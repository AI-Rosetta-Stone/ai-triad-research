{
  "name": "ai-triad-research",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  // false: use compose.yaml's own command (bootstrap + sleep infinity), so
  // Codespaces/VS Code bootstraps the same way plain `docker compose up` does.
  "overrideCommand": false,
  "workspaceFolder": "/workspaces/ai-triad-research",
  "runServices": ["neo4j"],
  "forwardPorts": [5173, 5174, 5175, 7862, 7474],
  "portsAttributes": {
    "5173": {
      "label": "taxonomy-editor (vite)",
      "onAutoForward": "openBrowser"
    },
    "5174": { "label": "poviewer (vite)", "onAutoForward": "notify" },
    "5175": { "label": "summary-viewer (vite)", "onAutoForward": "notify" },
    "7862": {
      "label": "taxonomy-editor API server",
      "onAutoForward": "silent"
    },
    "7474": { "label": "neo4j browser", "onAutoForward": "silent" }
  },
  "remoteEnv": {
    "AUTH_DISABLED": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ]
    }
  }
}
