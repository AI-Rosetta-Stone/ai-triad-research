  "cases": [
    {
      "id": "no-superseded",
      "nodes": [{ "id": "a" }, { "id": "b" }],
      "selectable": ["a", "b"],
      "superseded": [],
      "resolve": { "a": "a", "b": "b", "zz": null },
      "warn_kinds": []
    },
    {
      "id": "single-hop",
      "nodes": [{ "id": "a", "superseded_by": "b" }, { "id": "b" }],
