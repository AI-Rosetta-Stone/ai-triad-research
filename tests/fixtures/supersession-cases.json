      "superseded": ["a", "b", "x"],
      "resolve": { "x": "x", "a": "a", "b": "b" },
      "warn_kinds": ["cycle"]
    },
    {
      "id": "chain-into-dangling",
      "nodes": [{ "id": "x", "superseded_by": "a" }, { "id": "a", "superseded_by": "gone" }],
