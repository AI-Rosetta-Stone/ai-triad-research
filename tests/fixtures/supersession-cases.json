      "nodes": [{ "id": "a", "superseded_by": "b" }, { "id": "b", "superseded_by": "a" }, { "id": "c" }],
      "selectable": ["c"],
      "superseded": ["a", "b"],
      "resolve": { "a": "a", "b": "b", "c": "c" },
      "warn_kinds": ["cycle"]
    },
    {
      "id": "self-loop",
      "nodes": [{ "id": "a", "superseded_by": "a" }],
      "selectable": [],
      "superseded": ["a"],
      "resolve": { "a": "a" },
      "warn_kinds": ["cycle"]
    },
    {
      "id": "dangling-target",
