      "selectable": [],
      "superseded": ["a", "b", "x"],
      "resolve": { "a": "a", "b": "b", "x": "x" },
      "warn_kinds": ["cycle"]
    },
    {
      "id": "two-sources-one-survivor",
      "nodes": [{ "id": "a", "superseded_by": "s" }, { "id": "b", "superseded_by": "s" }, { "id": "s" }, { "id": "t" }],
