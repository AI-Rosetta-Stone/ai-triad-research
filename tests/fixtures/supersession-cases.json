    },
    {
      "id": "cross-kind-situation-to-pov",
      "nodes": [{ "id": "sit-001", "superseded_by": "acc-beliefs-001" }, { "id": "acc-beliefs-001" }],
      "selectable": ["acc-beliefs-001"],
      "superseded": ["sit-001"],
      "resolve": { "sit-001": "sit-001", "acc-beliefs-001": "acc-beliefs-001" },
      "warn_kinds": ["cross_kind"]
    },
    {
      "id": "cross-kind-pov-to-situation",
      "nodes": [{ "id": "acc-beliefs-002", "superseded_by": "sit-002" }, { "id": "sit-002" }],
      "selectable": ["sit-002"],
      "superseded": ["acc-beliefs-002"],
