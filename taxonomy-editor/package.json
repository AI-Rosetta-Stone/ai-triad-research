{
  "name": "taxonomy-editor",
  "version": "0.13.6",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "description": "Visual editor for AI Triad Research taxonomy JSON files",
  "homepage": "https://github.com/AI-Rosetta-Stone/ai-triad-research",
  "author": {
    "name": "Jeffrey Snover",
    "email": "jsnover13@gmail.com"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/main/taxonomy-editor/src/main/main.js",
  "scripts": {
    "generate:ai-model-union": "node scripts/generate-ai-model-union.cjs",
    "predev": "node scripts/check-drift.cjs",
    "dev": "npm run build:main && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:fresh": "cross-env CHECK_DRIFT_FETCH=1 npm run dev",
    "dev:vite": "vite",
    "dev:web": "cross-env VITE_TARGET=web vite --host 0.0.0.0",
    "dev:server": "npm run build:server && node dist/server/taxonomy-editor/src/server/server.js",
    "dev:container": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:main": "node -e \"const fs=require('fs');fs.rmSync('dist/main',{recursive:true,force:true});fs.rmSync('.tsbuildinfo/main.tsbuildinfo',{force:true})\" && tsc -p tsconfig.main.json",
    "licenses": "node scripts/generate-notices.cjs --output THIRD-PARTY-NOTICES.txt && node scripts/parse-licenses.cjs",
    "build": "npm run build:main && vite build && npm run licenses",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:server": "node -e \"const fs=require('fs');fs.rmSync('dist/server',{recursive:true,force:true});fs.rmSync('.tsbuildinfo/server.tsbuildinfo',{force:true})\" && tsc -p tsconfig.server.json && node scripts/check-server-lib-emits.mjs",
    "build:web": "cross-env VITE_TARGET=web vite build",
    "build:container": "npm run build:server && npm run build:web && npm run licenses",
    "start:server": "node dist/server/taxonomy-editor/src/server/server.js",
    "postinstall": "npx @electron/rebuild || exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "smoke:styled": "node smoke/run-smoke.mjs",
    "smoke:invariance:capture": "cross-env SMOKE_CAPTURE=1 node smoke/run-smoke.mjs",
    "smoke:invariance:capture:node24": "cross-env SMOKE_CAPTURE=1 node smoke/invariance-capture.mjs",
    "smoke:invariance:assert:node24": "node smoke/invariance-capture.mjs",
    "lint": "eslint src/ && node ../lib/eslint-rules/check-complexity-budget-disables.mjs src",
    "lint:fix": "eslint src/ --fix",
    "depgraph": "node scripts/depgraph.mjs --stats",
    "depgraph:query": "node scripts/depgraph.mjs --query",
    "depgraph:reverse": "node scripts/depgraph.mjs --reverse",
    "depgraph:orphans": "node scripts/depgraph.mjs --orphans",
    "depcruise": "node scripts/run-depcruise.mjs",
    "verify": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.server.json --noEmit && bash scripts/check-renderer-tsc.sh && eslint src/ --max-warnings=650 && npm run depcruise && vitest run && vite build"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.34.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@huggingface/transformers": "^4.3.1",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "decode-named-character-reference": "^1.3.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "micromark-util-decode-numeric-character-reference": "^2.0.2",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.30.0",
    "pino": "^10.4.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^6.29.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdast": "^4.0.4",
    "@types/qrcode": "^1.5.6",
    "unified": "^11.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "azurite": "^3.37.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.7.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "pino-pretty": "^13.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "workbox-window": "^7.4.1"
  }
}
