# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# Required. Pick your own; there is deliberately no default, because a shared default
# password in a public repo is no password. Neo4j requires at least 8 characters.
NEO4J_PASSWORD=

# At least one AI key (GEMINI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY or AI_API_KEY).
GEMINI_API_KEY=
