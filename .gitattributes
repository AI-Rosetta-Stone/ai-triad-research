# Default: let Git auto-detect text files and normalize line endings
* text=auto
# PowerShell scripts: always CRLF in the working tree.
# Windows PowerShell 5.1 is picky about line endings and also requires a
# UTF-8 BOM when files contain non-ASCII characters — see the CI job
# "Validate PowerShell file encoding" in .github/workflows/ci.yml which
# enforces the BOM requirement (Git itself has no `bom` attribute).
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.psd1   text eol=crlf
*.ps1xml text eol=crlf
# Shell scripts: LF only (broken by CRLF)
*.sh  text eol=lf
# Git hooks are extensionless shell scripts — CRLF breaks the `sh` interpreter (t/1926).
# Every hook, not just pre-commit: post-merge and pre-push were added later and checked out CRLF.
.githooks/* text eol=lf
# Web / config: LF
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
# Tool-generated and remaining text formats — pin LF so autocrlf=true does not
# mark them perpetually "about to be converted" (false-dirty) on Windows.
# Tool writers emit LF regardless of platform; without an explicit eol they fall
# through to `* text=auto` and go permanently dirty. See t/3825 / Pattern #78 Facet A.
*.snap   text eol=lf
*.py     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.mts    text eol=lf
*.jsonl  text eol=lf
*.prompt text eol=lf
*.bicep  text eol=lf
*.log    text eol=lf
# Binary files — never normalize
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
# Office documents — never normalize (don't rely on binary auto-detection)
*.pptx  binary
*.docx  binary
*.safetensors filter=lfs diff=lfs merge=lfs -text
