# Root .dockerignore — controls build context for taxonomy-editor/Dockerfile
# (Docker context is repo root, not taxonomy-editor/)

# Version control
.git
.gitignore
.gitattributes

# Other Electron apps (not needed for container build)
poviewer/
summary-viewer/

# Build outputs and caches
build/
# Patterns anchor at the context root, so a bare node_modules/ misses lib/ and
# lib/debate/. The dev compose app container installs into the bind mount with
# Linux symlinks that a Windows host can't read, which breaks the build (t/254).
**/node_modules/
taxonomy-editor/dist/
taxonomy-editor/release/

# Documentation and metadata
*.md
!CHANGELOG.md
!taxonomy-editor/THIRD-PARTY-NOTICES.txt
docs/
AgentGuideLines/

# CI/CD and deployment (not needed in image)
.github/
deploy/
!deploy/azure/entrypoint.sh
operations/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test files
tests/
**/*.test.ts
**/*.spec.ts
vitest.config.*

# Orca / agent config
.orca.yaml
**/.orca.yaml
**/.mcp.json
**/AGENTS.md
**/CLAUDE.md

# Orca overlay repo (bare git repo — can be 50MB+)
.orca-git/
.orca-gitignore

# Logs
*.log
npm-debug.log*

# Environment files (secrets)
.env
.env.*
!.env.template
